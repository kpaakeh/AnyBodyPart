{
  "schemaVersion": 1,
  "id": "anybodyparts",
  "version": "${version}",
  "name": "Any Body Parts",
  "description": "Lose, collect and stitch body parts with donor skins or weaker mechanical prostheses. Hop, crawl or roll as a head. By kpkh.",
  "authors": [
    "kpkh"
  ],
  "license": "All-Rights-Reserved",
  "icon": "assets/anybodyparts/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.kpkh.anybodyparts.AnyBodyParts"
    ],
    "client": [
      "net.kpkh.anybodyparts.client.AnyBodyPartsClient"
    ]
  },
  "mixins": [
    "anybodyparts.mixins.json",
    {
      "config": "anybodyparts.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.166.2+26.3"
  }
}